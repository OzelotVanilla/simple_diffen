{
    "compilerOptions": {
        "target": "esnext", // Bundler will make it compatible with browser baseline.
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "sourceMap": true,
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "globals.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
